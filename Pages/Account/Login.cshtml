@page
@model StudyRoom.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Вход в учебный кабинет</h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Login" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Login" class="form-control" placeholder="Введите логин (например, teacher или student1)" autocomplete="username" />
                        <span asp-validation-for="Input.Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Password" class="form-control" placeholder="Введите пароль" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Сохранять сессию на этом устройстве</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Войти в систему</button>
                    </div>
                </form>

                <hr class="my-4" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Ещё нет учётной записи студента?</span>
                    <a asp-page="/Account/Register" class="btn btn-outline-secondary btn-sm">Зарегистрироваться</a>
                </div>
            </div>
            <div class="card-footer bg-light p-3 small">
                <div class="fw-bold text-secondary mb-1">Демонстрационные учётные записи (DbSeeder):</div>
                <ul class="mb-0 ps-3 text-muted">
                    <li><strong>Преподаватель:</strong> логин <code>teacher</code>, пароль <code>Teacher123!</code></li>
                    <li><strong>Студент 1 (ИСП-41):</strong> логин <code>student1</code>, пароль <code>Student123!</code></li>
                    <li><strong>Студент 2 (ИСП-41):</strong> логин <code>student2</code>, пароль <code>Student123!</code></li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


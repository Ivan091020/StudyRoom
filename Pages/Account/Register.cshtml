@page
@model StudyRoom.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация студента";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Регистрация нового студента</h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label fw-semibold"></label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="Например: Смирнов Алексей Дмитриевич" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Login" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Login" class="form-control" placeholder="Уникальный логин для входа" />
                        <span asp-validation-for="Input.Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.StudentGroupId" class="form-label fw-semibold"></label>
                        <select asp-for="Input.StudentGroupId" asp-items="Model.GroupOptions" class="form-select">
                            <option value="">-- Выберите учебную группу --</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-success btn-lg">Зарегистрироваться и войти</button>
                        <a asp-page="/Account/Login" class="btn btn-outline-secondary">Вернуться ко входу</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


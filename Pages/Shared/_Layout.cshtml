<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Электронный учебный кабинет</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudyRoom.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-journal-bookmark-fill text-info"></i>
                    <span>Учебный кабинет</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index"><i class="bi bi-house-door me-1"></i>Главная</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsTeacher())
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-page="/Teacher/Index">
                                        <i class="bi bi-easel2-fill me-1"></i>Панель преподавателя
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Teacher/Disciplines">
                                        <i class="bi bi-book me-1"></i>Дисциплины и лекции
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Teacher/Reviews">
                                        <i class="bi bi-check2-square me-1"></i>Проверка ответов
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Teacher/Reports">
                                        <i class="bi bi-bar-chart-line me-1"></i>Отчёты и прогресс
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Teacher/Users">
                                        <i class="bi bi-people me-1"></i>Пользователи и группы
                                    </a>
                                </li>
                            }
                            @if (User.IsStudent() || User.IsTeacher())
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-info fw-semibold" asp-page="/Student/Index">
                                        <i class="bi bi-mortarboard me-1"></i>Кабинет студента
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="badge @(User.IsTeacher() ? "bg-warning text-dark" : "bg-info text-dark") px-2 py-1">
                                    @(User.IsTeacher() ? "Преподаватель" : "Студент")
                                </span>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-light">
                                    <i class="bi bi-person-circle me-1"></i>@User.GetFullName() <small class="text-secondary">(@User.Identity.Name)</small>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i>Выйти
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Вход
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i>Регистрация
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container my-4 flex-grow-1 pb-5">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small">
            <div>
                &copy; 2026 — <strong>Электронный учебный кабинет преподавателя и студента</strong> (ASP.NET Core 10.0 + PostgreSQL)
            </div>
            <div>
                <span class="text-secondary">Контроль последовательного освоения дисциплин</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

